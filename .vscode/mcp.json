{
  "servers": {
    "jatech-store-local": {
      "type": "http",
      "url": "http://localhost:7071/runtime/webhooks/mcp"
    },
    "jatech-store-azure": {
      "type": "http",
      "url": "https://${input:functionapp-name}.azurewebsites.net/runtime/webhooks/mcp"
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "functionapp-name",
      "description": "Function app name (azd env get-value AZURE_FUNCTION_NAME)"
    }
  ]
}
