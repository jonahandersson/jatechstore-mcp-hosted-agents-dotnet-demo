# Copy to .env for local runs. .env is excluded from the deploy ZIP by .agentignore.

# Foundry project endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=<your-foundry-project-endpoint>

# Model deployment name in that project
FOUNDRY_MODEL=<your-model-deployment>

# MCP server. Local Functions host (no auth):
MCP_SERVER_URL=http://localhost:7071/runtime/webhooks/mcp
MCP_SERVER_AUDIENCE=

# Or the deployed function app (Entra auth). Your own user must be allowed to call it,
# see the README, "Call the deployed server from your laptop".
# MCP_SERVER_URL=https://<function-app>.azurewebsites.net/runtime/webhooks/mcp
# MCP_SERVER_AUDIENCE=api://<from azd env get-value ENTRA_IDENTIFIER_URI>

# Optional: only expose some tools to the agent
# MCP_ALLOWED_TOOLS=search_catalog,get_product

# Local only: port Foundry probes, and use your az/azd sign-in instead of probing for a managed identity
ASPNETCORE_URLS=http://localhost:8088
AZURE_TOKEN_CREDENTIALS=dev
