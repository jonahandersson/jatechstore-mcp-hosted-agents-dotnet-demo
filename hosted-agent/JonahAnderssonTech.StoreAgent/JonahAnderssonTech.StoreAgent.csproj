<Project>

  <!--
    Based on the official Agent Framework sample
    dotnet/samples/04-hosting/FoundryHostedAgents/responses/Hosted-McpTools.

    Source (ZIP) deploy: Foundry runs `dotnet restore` + `dotnet publish` on this folder
    (dependencyResolution: remote_build in azure.yaml), so the project is self-contained.
    Azure.Identity, ModelContextProtocol and Microsoft.Extensions.AI come in transitively
    through the Agent Framework packages. Bump AgentFrameworkVersion rather than pinning them.
  -->

  <PropertyGroup>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JonahAnderssonTech.StoreAgent</RootNamespace>
    <AssemblyName>JonahAnderssonTech.StoreAgent</AssemblyName>
    <AgentFrameworkVersion>1.22.0-preview.260918.1</AgentFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="$(AgentFrameworkVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="$(AgentFrameworkVersion)" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />

</Project>
